

/*
I2S PIO slave receiver for the PCM1808 ADC. 
This ADC uses I2S format MSB 24 data bits zero padded to 32 bits per channel.
Standard I2S timing: LRCLK changes, 1 BCLK cycle delay, then 32 BCLK cycles of data (24-bit audio + 8-bit zero padding)
Data aligned to upper 3 bytes of 32-bit word (bits 31-8, with lower byte as zero padding)

Input pin order: DATA, BCK, LRCK

Must run at least 4x BCK.
NOTE: Set JMP pin to LRCK pin.
NOTE: The very first word read is potentially corrupt, since there is a
	chance to start in the middle of an L frame and only read part of it.
	Nevertheless, the frame order should be synchronized (first word is L,
	second is R, etc.)
*/

.program i2s_receiver

.define DATA_PIN 0
.define BCK_PIN 30   // Maps to (21 + 30) % 32 = 19 
.define LRCK_PIN 31  // Maps to (21 + 31) % 32 = 20

public_entry_point:
    wait 0 pin LRCK_PIN     // wait for L frame to come around before we start
sample_l:
    wait 1 pin BCK_PIN      // DATA should be sampled on rising transition of BCK
    in pins, 1              // read DATA
    wait 0 pin BCK_PIN      // don't sample more than once per rising edge, wait for next clock
    jmp pin start_sample_r  // if LRCK has gone high, we're "done" with this word
    jmp sample_l            // otherwise, continue reading Left channel
start_sample_r:
    push noblock            // push the completed Left channel word to the FIFO
sample_r:
    wait 1 pin BCK_PIN      // wait for BCK to rise
    in pins, 1              // read DATA
    wait 0 pin BCK_PIN      // wait for BCK to fall
    jmp pin sample_r        // if LRCK is still high, we're still sampling Right channel
    push noblock            // If LRCK has gone low, push the completed Right channel word
    jmp sample_l            // start the loop over for the next Left channel

% c-sdk {
/*
 *  Designed to be used with output master module, requiring overlapping pins:
 *    data_pin_base + 0 = input pin
 *    data_pin_base + 1 = out_master clock_pin_base
 *    data_pin_base + 2 = out_master clock_pin_base + 1
 *
 *  Intended to be run at SCK rate (4x BCK), so clock same as SCK module if using
 *  it, or 4x the BCK frequency (BCK is 64x fs, so 256x fs).
 */

static inline void i2s_receiver_program_init(PIO pio, uint8_t sm, uint8_t offset, uint8_t sd_pin, uint8_t bck_pin, uint8_t ws_pin)
{
	pio_gpio_init(pio, sd_pin);
	pio_gpio_init(pio, bck_pin);
	pio_gpio_init(pio, ws_pin);

    gpio_disable_pulls(sd_pin);
    gpio_disable_pulls(bck_pin);
    gpio_disable_pulls(ws_pin);

    pio_sm_config sm_config = i2s_receiver_program_get_default_config(offset);
    sm_config_set_in_pins(&sm_config, sd_pin);
    sm_config_set_in_shift(&sm_config, false, false, 0);
    sm_config_set_fifo_join(&sm_config, PIO_FIFO_JOIN_RX);
    sm_config_set_jmp_pin(&sm_config, ws_pin);
    pio_sm_init(pio, sm, offset, &sm_config);

	uint32_t pin_mask = (1u << sd_pin) | (1u << bck_pin) | (1u << ws_pin);
	pio_sm_set_pindirs_with_mask(pio, sm, 0, pin_mask); // set all specified pins as inputs (0 = input, 1 = output)
}
%}
